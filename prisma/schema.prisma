generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InsuranceCompany {
  ALLIANZ
  GENERALI
  GROUPAMA
  UNIQA
  KH_BIZTOSITO
  UNION
  SIGNAL_IDUNA
  WABERERS
  GENERTEL
  MAGYAR_POSTA_BIZTOSITO
  EGYEB
}

// A bekuldesi folyamat allapota:
// PENDING_TECHNICIAN — ugyfel beadta, technikusi munkalapra var
// COMPLETED          — munkalap lezarva, vegleges PDF + email kikuldve
// FAILED_PDF         — a vegleges PDF/email lepes elhasalt, ujraprobalhato
enum ReportStatus {
  PENDING_TECHNICIAN
  COMPLETED
  FAILED_PDF
}

enum VehicleCategory {
  SZEMELYGEPKOCSI
  TEHERGEPKOCSI
}

enum WorkProcess {
  CSERE
  JAVITAS
}

enum VehicleCondition {
  MEGBONTATLAN
  MOZGASKEPES
}

// Kárleírás gyors opciói (4. lépés) — lásd lib/damageTypes.ts
enum DamageType {
  SZELVEDO_JAVITAS
  SZELVEDO_CSERE
  EGYEB
}

// A tulajdonos (meghatalmazó) típusa — a feliratok (név/cégnév, lakcím/székhely,
// okmányszám/adószám) ehhez igazodnak. Az azonosító továbbra is az idOrTaxNumber mezőben van.
enum OwnerType {
  MAGANSZEMELY
  CEG
}

model DamageReport {
  id              String   @id @default(cuid())
  referenceNumber String   @unique
  createdAt       DateTime @default(now())

  // 1. lépés — Személyes adatok
  ownerType     OwnerType?
  ownerName     String
  ownerAddress  String?
  // "A vezető személye és a tulajdonos személye megegyezik" — ekkor egyszer írnak alá,
  // és ugyanaz az aláírás kerül mindkét dobozba (Vezető / Tulajdonos aláírása).
  driverSameAsOwner Boolean @default(false)
  driverName    String?
  driverAddress String?
  driverPhone   String?
  driverBirthDate         DateTime?
  driverLicenseNumber     String?
  driverLicenseValidUntil DateTime?
  customerEmail String
  customerPhone String?

  // 2. lépés — Jármű + biztosítás
  vehiclePlate     String
  vehicleMake      String
  vehicleModel     String
  vehicleYear      Int?
  vehicleVin       String?
  hasCasco         Boolean @default(false)
  cascoInsurer     String?
  liabilityInsurer String?
  relevantInsurer  String?
  // Jármű alapadatok (a felhasználó tölti ki, 2. lépés)
  vehicleRegistrationDate     DateTime?
  vehicleInspectionValidUntil DateTime?
  vehicleEngineCapacity       Int?
  vehiclePowerKw               Int?
  vehicleColor                 String?

  // 3. lépés — Baleset körülményei
  accidentDate              DateTime?
  accidentCountry           String?
  accidentCity              String?
  accidentStreet            String?
  outsideSettlement         Boolean   @default(false)
  roadNumber                String?
  kilometerMark             String?
  policeInvolved            Boolean   @default(false)
  policeStation             String?
  otherVehiclePlate         String?
  otherVehicleType          String?
  otherVehicleColor         String?
  additionalParties         String?
  vehicleInspectionLocation String?

  // 4. lépés — Kár leírása
  damageType        DamageType?
  damageDescription String?
  damagePoints      Json?
  photoUrls         String[]

  // 5. lépés — Felelősség nyilatkozatok
  liableParty        String?
  underInfluence     Boolean @default(false)
  licenseValid       Boolean @default(true)
  vatReclaimEligible    Boolean @default(false)
  taxNumber          String?
  consentToPhotocopy    Boolean @default(false)
  cascoClaimRequest     Boolean @default(false)
  vehicleEncumbrance    Boolean @default(false)
  encumbranceFinancier  String?

  // 6. lépés — Aláírás + GDPR
  ownerSignatureUrl  String?
  driverSignatureUrl String?
  gdprConsent        Boolean   @default(false)
  emailSentAt        DateTime?

  // Meghatalmazás — ügyfél azonosítás és illetékes biztosító
  idOrTaxNumber        String?
  insuranceCompany     InsuranceCompany?
  insuranceCompanyOther String?
  accept8DayPayment    Boolean           @default(false)
  knowsCascoTerms   Boolean           @default(false)

  // Jegyzőkönyv — átvétel/visszaadás időpontjai (technikus rögzíti)
  vehicleCheckIn  DateTime?
  vehicleCheckOut DateTime?

  // Jegyzőkönyv — technikusi adatok
  vehicleCategory          VehicleCategory?
  workProcess              WorkProcess?
  vehicleCondition         VehicleCondition?
  equipmentChecklist      Json?
  damageNotes             String?
  technicianName          String?
  technicianSignatureUrl  String?

  // Beküldési pipeline állapota
  status                    ReportStatus @default(PENDING_TECHNICIAN)
  technicianToken           String?      @unique
  technicianTokenExpiresAt  DateTime?
  finalPdfUrl               String?
  // A 3 önálló Meghatalmazás-PDF Supabase Storage URL-jei, LegalEntity.key szerinti kulcsokkal
  // ({ m1, autouveg, bodrogi }) — csak a műhely kapja meg emailben, lásd lib/finalize.ts.
  authorizationPdfUrls       Json?
  // A technikus által a Jegyzőkönyv lezárásakor kiválasztott meghatalmazások
  // (LegalEntity.key: "m1" | "autouveg" | "bodrogi"). Üres tömb (régi rekord) = mindhárom.
  selectedAuthorizations     String[] @default([])
  munkalapClosedAt          DateTime?
  pdfErrorMessage           String?

  // Szerkesztési token (magic link)
  editToken     String?   @unique
  tokenExpiresAt DateTime?
}
