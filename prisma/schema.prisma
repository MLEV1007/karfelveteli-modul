generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InsuranceCompany {
  ALLIANZ
  GENERALI
  GROUPAMA
  UNIQA
  KH_BIZTOSITO
  UNION
  SIGNAL_IDUNA
  WABERERS
  GENERTEL
  MAGYAR_POSTA_BIZTOSITO
  EGYEB
}

// A bekuldesi folyamat allapota:
// PENDING_TECHNICIAN — ugyfel beadta, technikusi munkalapra var
// COMPLETED          — munkalap lezarva, vegleges PDF + email kikuldve
// FAILED_PDF         — a vegleges PDF/email lepes elhasalt, ujraprobalhato
enum ReportStatus {
  PENDING_TECHNICIAN
  COMPLETED
  FAILED_PDF
}

model DamageReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 1. lépés — Személyes adatok
  ownerName     String
  ownerAddress  String?
  driverName    String?
  driverAddress String?
  driverPhone   String?
  customerEmail String
  customerPhone String?

  // 2. lépés — Jármű + biztosítás
  vehiclePlate     String
  vehicleMake      String
  vehicleModel     String
  vehicleYear      Int?
  vehicleVin       String?
  hasCasco         Boolean @default(false)
  cascoInsurer     String?
  liabilityInsurer String?
  relevantInsurer  String?

  // 3. lépés — Baleset körülményei
  accidentDate              DateTime?
  accidentCountry           String?
  accidentCity              String?
  accidentStreet            String?
  outsideSettlement         Boolean   @default(false)
  roadNumber                String?
  kilometerMark             String?
  policeInvolved            Boolean   @default(false)
  policeReportNo            String?
  policeStation             String?
  otherVehiclePlate         String?
  otherVehicleType          String?
  otherVehicleColor         String?
  additionalParties         String?
  vehicleInspectionLocation String?

  // 4. lépés — Kár leírása
  damageDescription String?
  damagePoints      Json?
  photoUrls         String[]

  // 5. lépés — Felelősség nyilatkozatok
  liableParty        String?
  underInfluence     Boolean @default(false)
  licenseValid       Boolean @default(true)
  taxNumber          String?
  consentToPhotocopy    Boolean @default(false)
  cascoClaimRequest     Boolean @default(false)
  vehicleEncumbrance    Boolean @default(false)
  encumbranceFinancier  String?

  // 6. lépés — Aláírás + GDPR
  ownerSignatureUrl  String?
  driverSignatureUrl String?
  gdprConsent        Boolean   @default(false)
  emailSentAt        DateTime?

  // Meghatalmazás — ügyfél azonosítás és illetékes biztosító
  idOrTaxNumber     String?
  insuranceCompany  InsuranceCompany?
  accept8DayPayment Boolean           @default(false)
  knowsCascoTerms   Boolean           @default(false)

  // Jegyzőkönyv — átvétel/visszaadás időpontjai (technikus rögzíti)
  vehicleCheckIn  DateTime?
  vehicleCheckOut DateTime?

  // Jegyzőkönyv — technikusi adatok
  equipmentChecklist      Json?
  damageNotes             String?
  technicianName          String?
  technicianSignatureUrl  String?

  // Beküldési pipeline állapota
  status                    ReportStatus @default(PENDING_TECHNICIAN)
  technicianToken           String?      @unique
  technicianTokenExpiresAt  DateTime?
  finalPdfUrl               String?
  munkalapClosedAt          DateTime?
  pdfErrorMessage           String?

  // Szerkesztési token (magic link)
  editToken     String?   @unique
  tokenExpiresAt DateTime?
}
